# =========================================================================
# Configuración de Base de Datos — ETL Huella de Carbono
# =========================================================================
# Copia este archivo como .env y ajusta los valores.
# Si no se crea .env, el ETL usará SQLite en data/huella_carbono_dw.db
# =========================================================================

# --- Opción 1: String de conexión completo (toma precedencia) -----------
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/huella_carbono_dw
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/huella_carbono_dw

# --- Opción 2: Variables individuales ------------------------------------
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=huella_carbono_dw
